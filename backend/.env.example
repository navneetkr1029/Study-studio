# Copy to .env for local development. On Vercel, set these as Environment Variables instead.

# ---- Option A: local Ollama (free, runs on your machine) ----
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# Reads text from images / scanned PDFs. Install with: ollama pull llava
OLLAMA_VISION_MODEL=llava

# ---- Option B: hosted model (needed on Vercel, which cannot reach your local Ollama) ----
# Works with OpenAI, Groq, OpenRouter, Together, or any OpenAI-compatible API.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# Allowed frontend origin(s), comma separated. Use your Vercel frontend URL in production.
CORS_ORIGINS=*

# Optional tuning (sensible defaults are chosen per provider)
# SINGLE_PASS_CHARS=7000
# CHUNK_CHARS=5000
# MAP_CONCURRENCY=1
# MAX_UPLOAD_MB=4
